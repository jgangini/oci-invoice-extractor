{
  "schema_version": 1,
  "diagram_type": "erd",
  "meta": {
    "title": "Modelo de datos de extracción de facturas",
    "subtitle": "INV_DATA · Catálogo, documentos, resultados y aprobaciones",
    "locale": "es",
    "output": "docs/modelo/inv-data.html",
    "quality_profile": "standard",
    "views": [
      {
        "id": "config",
        "label": "Configuración",
        "focus": [
          "inv_operator",
          "inv_settings",
          "inv_route",
          "inv_target",
          "inv_template",
          "inv_field"
        ],
        "note": "La ruta asigna un destino lógico y una versión de la plantilla a un prefijo del bucket."
      },
      {
        "id": "lote",
        "label": "Del ZIP al resultado",
        "focus": [
          "inv_batch",
          "inv_document",
          "inv_run",
          "inv_result",
          "inv_doc_checkpoint"
        ],
        "note": "Cada generación procesa los miembros PDF del lote y conserva los valores obtenidos."
      },
      {
        "id": "aprobacion",
        "label": "Revisión de un campo",
        "focus": [
          "inv_field",
          "inv_run",
          "inv_result",
          "inv_review"
        ],
        "note": "La revisión registra el valor aprobado y el motivo. La extracción original permanece disponible."
      },
      {
        "id": "prueba",
        "label": "Prueba y evidencia",
        "focus": [
          "inv_pdf_test",
          "inv_test_page",
          "inv_template"
        ],
        "note": "Cada prueba usa una versión de plantilla. Las miniaturas y líneas OCR permiten ubicar los campos en la página revisada."
      }
    ]
  },
