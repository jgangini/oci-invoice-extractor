{
  "schema_version": 2,
  "execution_source": "oci_resource_manager",
  "project_id": "oci-invoice-extractor",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": false
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "default_compartment_name": "oci-invoice-extractor",
    "database_profile": "new_or_existing",
    "region_selection": "subscribed_compatible",
    "existing_database_wallet": "none"
  },
  "form": {
    "email_access_fields": [
      "apex_operator",
      "apex_operator_password"
    ],
    "groups": [
      {
        "id": "credentials",
        "title": "OCI credentials",
        "items": [
          {
            "kind": "control",
            "name": "oci_config",
            "label": "OCI config"
          },
          {
            "kind": "control",
            "name": "oci_key",
            "label": "API private key"
          }
        ]
      },
      {
        "id": "deployment",
        "title": "Services to deploy",
        "items": [
          {
            "kind": "control",
            "name": "oci_region",
            "label": "OCI region",
            "span": 2
          },
          {
            "kind": "control",
            "name": "compartment_mode",
            "label": "Compartment mode",
            "options": [
              {
                "value": "new",
                "label": "New compartment"
              },
              {
                "value": "existing",
                "label": "Existing compartment"
              }
            ]
          },
          {
            "kind": "control",
            "name": "new_compartment",
            "label": "New compartment name"
          },
          {
            "kind": "control",
            "name": "existing_compartment",
            "label": "Existing compartment"
          }
        ]
      },
      {
        "id": "storage",
        "title": "Object Storage",
        "items": [
          {
            "kind": "field",
            "name": "bucket_mode"
          },
          {
            "kind": "field",
            "name": "new_bucket_name"
          },
          {
            "kind": "field",
            "name": "existing_bucket_name"
          },
          {
            "kind": "field",
            "name": "source_prefix"
          }
        ]
      },
      {
        "id": "vault",
        "title": "OCI Vault",
        "items": [
          {
            "kind": "field",
            "name": "vault_mode"
          },
          {
            "kind": "field",
            "name": "existing_vault_id"
          },
          {
            "kind": "field",
            "name": "existing_key_id"
          }
        ]
      },
      {
        "id": "database",
        "title": "Oracle AI Database",
        "items": [
          {
            "kind": "field",
            "name": "autonomous_database_mode"
          },
          {
            "kind": "field",
            "name": "autonomous_database_version"
          },
          {
            "kind": "field",
            "name": "existing_autonomous_database_id"
          },
          {
            "kind": "field",
            "name": "autonomous_database_admin_password"
          }
        ]
      },
      {
        "id": "network",
        "title": "Networking",
        "items": [
          {
            "kind": "field",
            "name": "network_mode",
            "span": 2
          },
          {
            "kind": "field",
            "name": "new_vcn_cidr"
          },
          {
            "kind": "field",
            "name": "new_subnet_cidr"
          },
          {
            "kind": "field",
            "name": "existing_network_compartment_id",
            "span": 2
          },
          {
            "kind": "field",
            "name": "existing_vcn_id"
          },
          {
            "kind": "field",
            "name": "existing_subnet_id"
          },
          {
            "kind": "field",
            "name": "access_cidrs"
          }
        ]
      },
      {
        "id": "apex",
        "title": "APEX access",
        "items": [
          {
            "kind": "field",
            "name": "apex_operator"
          },
          {
            "kind": "field",
            "name": "apex_operator_password"
          }
        ]
      }
    ],
    "fields": [
      {
        "name": "vault_mode",
        "label": "Vault mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new vault"
          },
          {
            "value": "existing",
            "label": "Use existing vault"
          }
        ]
      },
      {
        "name": "existing_vault_id",
        "label": "Existing vault",
        "type": "select",
        "required": true,
        "options_source": "oci_active_vaults",
        "visible_when": {
          "field": "vault_mode",
          "equals": "existing"
        }
      },
      {
        "name": "existing_key_id",
        "label": "Encryption key",
        "type": "select",
        "required": true,
        "options_source": "oci_vault_aes_keys",
        "visible_when": {
          "field": "vault_mode",
          "equals": "existing"
        }
      },
      {
        "name": "bucket_mode",
        "label": "Bucket mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new bucket"
          },
          {
            "value": "existing",
            "label": "Use existing bucket"
          }
        ]
      },
      {
        "name": "new_bucket_name",
        "label": "New bucket name",
        "type": "text",
        "required": true,
        "default": "oci-invoice-extractor",
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_\\-]{0,254}$",
        "visible_when": {
          "field": "bucket_mode",
          "equals": "new"
        }
      },
      {
        "name": "existing_bucket_name",
        "label": "Existing bucket",
        "type": "select",
        "required": true,
        "options_source": "oci_active_buckets",
        "visible_when": {
          "field": "bucket_mode",
          "equals": "existing"
        }
      },
      {
        "name": "autonomous_database_mode",
        "label": "Database mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {
            "value": "new",
            "label": "Create new database"
          },
          {
            "value": "existing",
            "label": "Use existing database"
          }
        ]
      },
      {
        "name": "autonomous_database_version",
        "label": "Database profile",
        "type": "select",
        "required": true,
        "transform": "database_profile",
        "options": [
          {
            "value": "26ai:OLTP",
            "label": "Oracle AI Database 26ai · Transaction Processing (OLTP) · 4 ECPU · 1 TB"
          }
        ],
        "default": "26ai:OLTP",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        }
      },
      {
        "name": "existing_autonomous_database_id",
        "label": "Existing database",
        "type": "select",
        "required": true,
        "options_source": "oci_autonomous_oltp_databases",
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "existing"
        }
      },
      {
        "name": "autonomous_database_admin_password",
        "label": "Database admin password",
        "type": "password",
        "required": true,
        "secret": true,
        "generate_password": true,
        "generate_password_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        }
      },
      {
        "name": "network_mode",
        "label": "Network mode",
        "type": "select",
        "required": true,
        "default": "new",
        "options": [
          {"value": "new", "label": "Create new VCN and subnet"},
          {"value": "existing", "label": "Use existing VCN and subnet"}
        ]
      },
      {
        "name": "new_vcn_cidr",
        "label": "VCN IPv4 CIDR",
        "type": "text",
        "required": true,
        "default": "10.80.0.0/24",
        "pattern": "^[0-9.]+/(1[6-9]|2[0-9]|30)$",
        "visible_when": {"field": "network_mode", "equals": "new"}
      },
      {
        "name": "new_subnet_cidr",
        "label": "Private subnet IPv4 CIDR",
        "type": "text",
        "required": true,
        "default": "10.80.0.0/25",
        "pattern": "^[0-9.]+/(1[6-9]|2[0-9]|30)$",
        "visible_when": {"field": "network_mode", "equals": "new"}
      },
      {
        "name": "existing_network_compartment_id",
        "label": "Network compartment",
        "type": "select",
        "required": true,
        "options_source": "oci_network_compartments",
        "visible_when": {"field": "network_mode", "equals": "existing"}
      },
      {
        "name": "existing_vcn_id",
        "label": "Existing VCN",
        "type": "select",
        "required": true,
        "options_source": "oci_active_vcns",
        "options_parent": "existing_network_compartment_id",
        "visible_when": {"field": "network_mode", "equals": "existing"}
      },
      {
        "name": "existing_subnet_id",
        "label": "Existing private subnet",
        "type": "select",
        "required": true,
        "options_source": "oci_private_subnets",
        "options_parent": "existing_vcn_id",
        "visible_when": {"field": "network_mode", "equals": "existing"}
      },
      {
        "name": "access_cidrs",
        "label": "Public IPv4 ranges for ADB and APEX",
        "type": "text",
        "default": "0.0.0.0/0",
        "pattern": "(?:0\\.0\\.0\\.0/0|(?:(?:25[0-5]|(?:2[0-4]|1[0-9]|[1-9]?)[0-9])\\.){3}(?:25[0-5]|(?:2[0-4]|1[0-9]|[1-9]?)[0-9])/(?:2[4-9]|3[0-2])(?: *, *(?:(?:25[0-5]|(?:2[0-4]|1[0-9]|[1-9]?)[0-9])\\.){3}(?:25[0-5]|(?:2[0-4]|1[0-9]|[1-9]?)[0-9])/(?:2[4-9]|3[0-2]))*)",
        "required": true,
        "visible_when": {
          "field": "autonomous_database_mode",
          "equals": "new"
        }
      },
      {
        "name": "source_prefix",
        "label": "Input folder prefix",
        "type": "text",
        "required": true,
        "pattern": "^([A-Za-z0-9_\\-]+/)+$",
        "default": "source/",
        "visible_when": {
          "field": "bucket_mode",
          "equals": "existing"
        }
      },
      {
        "name": "apex_operator",
        "label": "Initial APEX username",
        "type": "text",
        "required": true,
        "pattern": "^[A-Za-z][A-Za-z0-9_.\\-]{2,63}$",
        "default": "INVOICE_ADMIN"
      },
      {
        "name": "apex_operator_password",
        "label": "Initial APEX password",
        "type": "password",
        "required": true,
        "secret": true,
        "min_length": 12,
        "max_length": 128,
        "generate_password": true
      }
    ]
  },
  "presentation": {
    "title": "OCI Invoice Extractor",
    "summary": "Extract invoice fields from ZIP files with OCI Functions and review the results in Oracle APEX.",
    "image": "/assets/oci-invoice-extractor-card.png",
    "image_alt": "Red scanner highlighting fields on an invoice",
    "tags": [
      "OCI Functions",
      "APEX",
      "Object Storage"
    ],
    "href": "https://github.com/jgangini/oci-invoice-extractor"
  },
  "run_steps": [
    {
      "key": "queue",
      "label": "Queued"
    },
    {
      "key": "credentials",
      "label": "Verify credentials and release"
    },
    {
      "key": "compartment",
      "label": "Resolve compartment"
    },
    {
      "key": "stack",
      "label": "Prepare Resource Manager stack"
    },
    {
      "key": "plan",
      "label": "Validate plan"
    },
    {
      "key": "apply",
      "label": "Provision resources"
    },
    {
      "key": "application",
      "label": "Install database schemas and APEX, then enable events"
    },
    {
      "key": "complete",
      "label": "Complete deployment"
    }
  ],
  "outputs": [
    "application_url",
    "autonomous_database_id",
    "db_dsn",
    "apex_base_url",
    "bucket_name",
    "object_namespace",
    "source_prefix",
    "event_rule_id",
    "function_id",
    "function_invoke_url",
    "bucket_compartment_id",
    "runtime_secret_ocid",
    "admin_secret_ocid"
  ],
  "email": {
    "services": [
      {
        "title": "Oracle APEX",
        "fields": [
          {"label": "Access URL", "output": "application_url", "link": true},
          {"label": "Username", "input": "apex_operator"},
          {"label": "Password", "input": "apex_operator_password"}
        ]
      }
    ],
    "attachments": ["deployment.log"]
  },
  "preflight": {
    "entrypoint": "deploy/hooks/preflight.py",
    "requires_oci_credentials": true,
    "secret_inputs": [
      "autonomous_database_admin_password"
    ],
    "release_assets": [
      {
        "name": "function-image.tar",
        "max_bytes": 1073741824,
        "download": false
      }
    ]
  },
  "post_apply": {
    "entrypoint": "deploy/hooks/post_apply.py",
    "requires_oci_credentials": true,
    "secret_inputs": [
      "apex_operator_password",
      "autonomous_database_admin_password"
    ],
    "include_paths": [
      "database",
      "apex/f100.sql",
      "source/invoice-catalog.json"
    ],
    "timeout_seconds": 1200
  },
  "prepare": {
    "owned_container_repository": true,
    "entrypoint": "deploy/hooks/prepare_image.py",
    "requires_oci_credentials": true,
    "timeout_seconds": 1200,
    "release_assets": [
      {
        "name": "function-image.tar",
        "max_bytes": 1073741824,
        "download": true
      }
    ],
    "output_variables": {
      "function_image_ocid": "ocid",
      "function_image_digest": "sha256"
    }
  },
  "pre_destroy": {
    "entrypoint": "deploy/hooks/uninstall.py",
    "requires_oci_credentials": true,
    "outputs": ["db_dsn", "event_rule_id", "function_id", "bucket_compartment_id"],
    "when": {"field": "autonomous_database_mode", "equals": "existing"},
    "password_field": "autonomous_database_admin_password"
  }
}
