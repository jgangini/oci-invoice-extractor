{
  "schema_version": 2,
  "execution_source": "oci_resource_manager",
  "project_id": "oci-invoice-extractor",
  "terraform": {
    "path": "terraform",
    "package_oci_credentials": false
  },
  "capabilities": {
    "compartment_modes": [
      "new",
      "existing"
    ],
    "default_compartment_name": "oci-invoice-extractor",
    "database_profile": "new",
    "region_selection": "subscribed_compatible"
  },
  "form": {
    "groups": [
      {
        "id": "credentials",
        "title": "OCI credentials",
        "items": [
          {
            "kind": "control",
            "name": "oci_config",
            "label": "OCI config"
          },
          {
            "kind": "control",
            "name": "oci_key",
            "label": "API private key"
          }
        ]
      },
      {
        "id": "deployment",
        "title": "Services to deploy",
        "items": [
          {
            "kind": "control",
            "name": "oci_region",
            "label": "OCI region",
            "span": 2
          },
          {
            "kind": "control",
            "name": "compartment_mode",
            "label": "Compartment mode",
            "options": [
              {
                "value": "new",
                "label": "New compartment"
              },
              {
                "value": "existing",
                "label": "Existing compartment"
              }
            ]
          },
          {
            "kind": "control",
            "name": "new_compartment",
            "label": "New compartment name"
          },
          {
            "kind": "control",
            "name": "existing_compartment",
            "label": "Existing compartment"
          }
        ]
      },
      {
        "id": "image",
        "title": "Function image",
        "items": [
          {
            "kind": "field",
            "name": "function_image_ocid"
          },
          {
            "kind": "field",
            "name": "function_image_digest"
          }
        ]
      },
      {
        "id": "database",
        "title": "Autonomous Database and network",
        "items": [
          {
            "kind": "field",
            "name": "admin_secret_ocid"
          },
          {
            "kind": "field",
            "name": "runtime_secret_ocid"
          },
          {
            "kind": "field",
            "name": "access_cidrs",
            "span": 2
          }
        ]
      },
      {
        "id": "ingest",
        "title": "Extraction and APEX access",
        "items": [
          {
            "kind": "field",
            "name": "source_prefix"
          },
          {
            "kind": "field",
            "name": "apex_operator"
          },
          {
            "kind": "field",
            "name": "apex_operator_password"
          }
        ]
      }
    ],
    "fields": [
      {
        "name": "function_image_ocid",
        "label": "Container image OCID",
        "type": "text",
        "required": true,
        "pattern": "^ocid1\\.containerimage\\.[a-z0-9.-]+$"
      },
      {
        "name": "function_image_digest",
        "label": "Image digest (SHA-256)",
        "type": "text",
        "required": true,
        "pattern": "^sha256:[0-9a-f]{64}$"
      },
      {
        "name": "admin_secret_ocid",
        "label": "ADMIN Vault secret OCID",
        "type": "text",
        "required": true,
        "pattern": "^ocid1\\.vaultsecret\\.[a-z0-9.-]+$"
      },
      {
        "name": "runtime_secret_ocid",
        "label": "INV_FN Vault secret OCID",
        "type": "text",
        "required": true,
        "pattern": "^ocid1\\.vaultsecret\\.[a-z0-9.-]+$"
      },
      {
        "name": "access_cidrs",
        "label": "Worker and APEX IPv4 CIDRs (/24 to /32, comma-separated)",
        "type": "text",
        "required": true
      },
      {
        "name": "source_prefix",
        "label": "Input folder prefix",
        "type": "text",
        "required": true,
        "pattern": "^([A-Za-z0-9_-]+/)+$",
        "default": "entrada/"
      },
      {
        "name": "apex_operator",
        "label": "Initial APEX username",
        "type": "text",
        "required": true,
        "pattern": "^[A-Za-z][A-Za-z0-9_.-]{2,63}$",
        "default": "INVOICE_ADMIN"
      },
      {
        "name": "apex_operator_password",
        "label": "Initial APEX password",
        "type": "password",
        "required": true,
        "secret": true,
        "min_length": 12,
        "max_length": 128,
        "generate_password": true
      }
    ]
  },
  "presentation": {
    "title": "OCI Invoice Extractor",
    "summary": "Extract invoice fields from ZIP files with OCI Functions and review the results in Oracle APEX.",
    "tags": [
      "OCI Functions",
      "APEX",
      "Object Storage"
    ],
    "href": "https://github.com/jgangini/oci-invoice-extractor"
  },
  "run_steps": [
    {
      "key": "queue",
      "label": "Queued"
    },
    {
      "key": "credentials",
      "label": "Verify credentials and release"
    },
    {
      "key": "compartment",
      "label": "Resolve compartment"
    },
    {
      "key": "stack",
      "label": "Prepare Resource Manager stack"
    },
    {
      "key": "plan",
      "label": "Validate plan"
    },
    {
      "key": "apply",
      "label": "Provision resources"
    },
    {
      "key": "application",
      "label": "Install database schemas and APEX, then enable events"
    },
    {
      "key": "complete",
      "label": "Complete deployment"
    }
  ],
  "outputs": [
    "application_url",
    "autonomous_database_id",
    "db_dsn",
    "apex_base_url",
    "bucket_name",
    "object_namespace",
    "source_prefix",
    "event_rule_id",
    "function_id",
    "function_invoke_url"
  ],
  "preflight": {
    "entrypoint": "deploy/hooks/preflight.py",
    "requires_oci_credentials": true
  },
  "post_apply": {
    "entrypoint": "deploy/hooks/post_apply.py",
    "requires_oci_credentials": true,
    "secret_inputs": [
      "apex_operator_password"
    ],
    "include_paths": [
      "database",
      "apex/f100.sql"
    ],
    "timeout_seconds": 1200
  }
}
