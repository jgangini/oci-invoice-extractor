page 2 (
    name: Batch documents
    alias: DOCUMENTOS
    title: Batch documents
    appearance {
        pageTemplate: @/standard
    }
    security {
        authorizationScheme: @review
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region lote (
        name: Batch
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
        }
    )
    pageItem P2_BATCH (
        type: textField
        label {
            label: Batch number
        }
        layout {
            sequence: 10
            region: @lote
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )
    button retry (
        buttonName: RETRY
        label: Retry batch
        layout {
            sequence: 20
            region: @lote
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
    )
    process retry (
        name: Retry batch
        type: executeCode
        source {
            plsqlCode:
            ```plsql
            begin inv_data.inv_ui.retry_batch(:P2_BATCH); end;
            ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Retry requested.
        }
        serverSideCondition {
            whenButtonPressed: @retry
        }
    )
    region documentos (
        name: Documents
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
            ```sql
            select document_id, member_name, generation, error_code from inv_data.inv_v_documents where batch_id=:P2_BATCH order by generation desc, document_id
            ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No records to display.
        }
        column DOCUMENT_ID (
            reportColumnQueryId: 1
            derivedColumn: N

            heading {
                heading: Document
            }
            layout {
                sequence: 10
            }

        )
        column MEMBER_NAME (
            reportColumnQueryId: 2
            derivedColumn: N

            heading {
                heading: PDF
            }
            layout {
                sequence: 20
            }

        )
        column GENERATION (
            reportColumnQueryId: 3
            derivedColumn: N

            heading {
                heading: Attempt
            }
            layout {
                sequence: 30
            }

        )
        column ERROR_CODE (
            reportColumnQueryId: 4
            derivedColumn: N

            heading {
                heading: Issue
            }
            layout {
                sequence: 40
            }

        )
    )
    region campos (
        name: Fields and evidence
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
            ```sql
            select result_id, member_name, label, effective_value,
                   case r.review_state when 'DISCREPANCIA' then 'Discrepancy' when 'REVISAR' then 'Needs review'
                       when 'APROBADO' then 'Approved' when 'LEIDO' then 'Read' else r.review_state end review_state,
                   page_no, method, evidence, nvl(review_id,0) revision from inv_data.inv_v_results r where batch_id=:P2_BATCH
            order by case r.review_state when 'DISCREPANCIA' then 0 when 'REVISAR' then 1 else 2 end, document_id, field_key
            ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No records to display.
        }
        column RESULT_ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                heading: Review
            }
            layout {
                sequence: 10
            }
            link {
                target: {
                    page: 3
                    items: {
                        P3_RESULT: \#RESULT_ID#\
                        P3_REV: \#REVISION#\
                    }
                }
                linkText: \#RESULT_ID#\
            }
        )
        column MEMBER_NAME (
            reportColumnQueryId: 2
            derivedColumn: N

            heading {
                heading: PDF
            }
            layout {
                sequence: 20
            }

        )
        column LABEL (
            reportColumnQueryId: 3
            derivedColumn: N

            heading {
                heading: Field
            }
            layout {
                sequence: 30
            }

        )
        column EFFECTIVE_VALUE (
            reportColumnQueryId: 4
            derivedColumn: N

            heading {
                heading: Current value
            }
            layout {
                sequence: 40
            }

        )
        column REVIEW_STATE (
            reportColumnQueryId: 5
            derivedColumn: N

            heading {
                heading: Status
            }
            layout {
                sequence: 50
            }

        )
        column PAGE_NO (
            reportColumnQueryId: 6
            derivedColumn: N

            heading {
                heading: Page
            }
            layout {
                sequence: 60
            }

        )
        column METHOD (
            reportColumnQueryId: 7
            derivedColumn: N

            heading {
                heading: Method
            }
            layout {
                sequence: 70
            }

        )
        column EVIDENCE (
            reportColumnQueryId: 8
            derivedColumn: N

            heading {
                heading: Evidence
            }
            layout {
                sequence: 80
            }

        )
        column REVISION (
            reportColumnQueryId: 9
            derivedColumn: N

            heading {
                heading: Review
            }
            layout {
                sequence: 90
            }

        )
    )
)
