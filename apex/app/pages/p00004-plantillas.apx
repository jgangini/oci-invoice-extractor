page 4 (
    name: Templates
    alias: PLANTILLAS
    title: Templates
    appearance {
        pageTemplate: @/standard
    }
    security {
        authorizationScheme: @admin
        pageAccessProtection: argumentsMustHaveChecksum
    }
    javaScript {
        fileUrls: #APP_FILES#invoice-editor.js?v=2
        executeWhenPageLoads: InvoiceEditor.start();
    }
    region editor (
        name: Template editor
        type: staticContent
        source {
            htmlCode:
```html
<div id="invoice-editor" class="inv-console">
  <div class="inv-toolbar">
    <button type="button" id="inv-import">Import JSON</button>
    <input id="inv-json-file" type="file" accept=".json,application/json" hidden>
  </div>
  <div class="inv-pair"><label>Template name<input id="inv-name" maxlength="100" required></label></div>
  <div class="inv-toolbar"><h2>Fields</h2><button type="button" id="inv-add">Add field</button></div>
  <div id="inv-fields"></div>
  <div class="inv-toolbar"><button type="button" id="inv-save" class="inv-primary">Save template</button><button type="button" id="inv-download">Download JSON</button></div>
  <p id="inv-message" role="status"></p>
</div>
```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
        }
    )
    process abrir (
        name: ABRIR
        type: executeCode
        source {
            plsqlCode:
```plsql
declare data_ clob; begin
  select definition into data_ from inv_data.inv_v_templates;
  apex_json.open_object; apex_json.write('definition',data_); apex_json.close_object;
exception when no_data_found then apex_json.open_object; apex_json.close_object;
end;
```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
    )
    process guardar (
        name: GUARDAR
        type: executeCode
        source {
            plsqlCode:
```plsql
declare c clob; v number; begin
  dbms_lob.createtemporary(c,true);
  for i in 1..apex_application.g_f01.count loop
    if dbms_lob.getlength(c) + length(apex_application.g_f01(i)) > 250000 then
      raise_application_error(-20011,'The template exceeds 250,000 characters.');
    end if;
    c:=c || apex_application.g_f01(i);
  end loop;
  inv_data.inv_ui.save_template(c,v);
  apex_json.open_object; apex_json.write('id',v); apex_json.close_object;
exception when dup_val_on_index then raise_application_error(-20011,'Each field key must be unique.');
end;
```
        }
        execution {
            sequence: 10
            point: ajaxCallback
        }
    )

)
