page 4 (
    name: Plantillas
    alias: PLANTILLAS
    title: Plantillas
    appearance {
        pageTemplate: @/standard
    }
    security {
        authorizationScheme: @admin
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region archivo (
        name: Nueva versión
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
        }
    )
    pageItem P4_FILE (
        type: fileUpload
        label {
            label: Plantilla JSON
        }
        layout {
            sequence: 10
            region: @archivo
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
        display {
            displayAs: blockDropzone
        }
        storage {
            type: appTempFiles
            maxFileSize: 250
        }
    )
    button previsualizar (
        buttonName: PREVISUALIZAR
        label: Previsualizar
        layout {
            sequence: 10
            region: @archivo
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
    )
    process previsualizar (
        name: Previsualizar
        type: executeCode
        source {
            plsqlCode:
            ```plsql
            declare b blob; c clob; dest integer:=1; src integer:=1; ctx integer:=0; warn integer; begin
            select blob_content into b from apex_application_temp_files where name=:P4_FILE and application_id=:APP_ID;
            dbms_lob.createtemporary(c,true);
            dbms_lob.converttoclob(c,b,dbms_lob.lobmaxsize,dest,src,nls_charset_id('AL32UTF8'),ctx,warn);
            if warn<>0 or not json_object_t.parse(c).has('fields') then raise_application_error(-20012,'Plantilla JSON inválida'); end if;
            apex_collection.create_or_truncate_collection('INV_PREVIEW');
            apex_collection.add_member(p_collection_name=>'INV_PREVIEW',p_clob001=>c);
            end;
            ```
        }
        execution {
            sequence: 10
        }
        successMessage {
            successMessage: Vista previa disponible.
        }
        serverSideCondition {
            whenButtonPressed: @previsualizar
        }
    )
    region vista (
        name: Campos de la versión propuesta
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
            ```sql
            select j.k,j.lbl,j.typ,j.app from apex_collections a cross apply json_table(a.clob001,'$.fields[*]' columns (k varchar2(64) path '$.key',lbl varchar2(200) path '$.label',typ varchar2(12) path '$.type',app varchar2(16) path '$.applicability')) j where a.collection_name='INV_PREVIEW'
            ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Sin registros para mostrar.
        }
        column K (
            reportColumnQueryId: 1
            derivedColumn: N

            heading {
                heading: Clave
            }
            layout {
                sequence: 10
            }

        )
        column LBL (
            reportColumnQueryId: 2
            derivedColumn: N

            heading {
                heading: Campo
            }
            layout {
                sequence: 20
            }

        )
        column TYP (
            reportColumnQueryId: 3
            derivedColumn: N

            heading {
                heading: Tipo
            }
            layout {
                sequence: 30
            }

        )
        column APP (
            reportColumnQueryId: 4
            derivedColumn: N

            heading {
                heading: Aplicabilidad
            }
            layout {
                sequence: 40
            }

        )
    )
    button publicar (
        buttonName: PUBLICAR
        label: Publicar versión
        layout {
            sequence: 20
            region: @archivo
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
    )
    process publicar (
        name: Publicar versión
        type: executeCode
        source {
            plsqlCode:
            ```plsql
            declare c clob; v number; begin select clob001 into c from apex_collections where collection_name='INV_PREVIEW' and seq_id=1; inv_data.inv_ui.publish(c,v); apex_collection.delete_collection('INV_PREVIEW'); end;
            ```
        }
        execution {
            sequence: 20
        }
        successMessage {
            successMessage: Versión publicada.
        }
        serverSideCondition {
            whenButtonPressed: @publicar
        }
    )
    region versiones (
        name: Versiones publicadas
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
            ```sql
            select version_id,name,version_no,created_at from inv_data.inv_v_templates order by version_id desc
            ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: Sin registros para mostrar.
        }
        column VERSION_ID (
            reportColumnQueryId: 1
            derivedColumn: N

            heading {
                heading: ID
            }
            layout {
                sequence: 10
            }

        )
        column NAME (
            reportColumnQueryId: 2
            derivedColumn: N

            heading {
                heading: Nombre
            }
            layout {
                sequence: 20
            }

        )
        column VERSION_NO (
            reportColumnQueryId: 3
            derivedColumn: N

            heading {
                heading: Versión
            }
            layout {
                sequence: 30
            }

        )
        column CREATED_AT (
            reportColumnQueryId: 4
            derivedColumn: N

            heading {
                heading: Publicada
            }
            layout {
                sequence: 40
            }

        )
    )
)
