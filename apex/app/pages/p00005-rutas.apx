page 5 (
    name: Routes
    alias: RUTAS
    title: Routes
    appearance {
        pageTemplate: @/standard
    }
    security {
        authorizationScheme: @admin
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region activas (
        name: Active routes
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
            ```sql
            select prefix,name,target_key from inv_data.inv_v_routes order by prefix
            ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No records to display.
        }
        column PREFIX (
            reportColumnQueryId: 1
            derivedColumn: N

            heading {
                heading: Prefix
            }
            layout {
                sequence: 10
            }

        )
        column NAME (
            reportColumnQueryId: 2
            derivedColumn: N

            heading {
                heading: Template
            }
            layout {
                sequence: 20
            }

        )
        column TARGET_KEY (
            reportColumnQueryId: 3
            derivedColumn: N

            heading {
                heading: Target
            }
            layout {
                sequence: 40
            }

        )
    )
    region ruta (
        name: Configure route
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
        }
    )
    pageItem P5_OLD (
        type: textField
        label {
            label: Route to replace
        }
        layout {
            sequence: 10
            region: @ruta
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )
    pageItem P5_PREFIX (
        type: textField
        label {
            label: Source prefix
        }
        layout {
            sequence: 20
            region: @ruta
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )
    pageItem P5_TARGET (
        type: selectList
        label {
            label: Logical target
        }
        layout {
            sequence: 40
            region: @ruta
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }
        lov {
            type: sqlQuery
            sqlQuery: select title d, target_key r from inv_data.inv_v_targets order by title
        }
    )
    button guardar (
        buttonName: GUARDAR
        label: Save route
        layout {
            sequence: 50
            region: @ruta
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
    )
    process guardar (
        name: Save route
        type: executeCode
        source {
            plsqlCode:
            ```plsql
            begin inv_data.inv_ui.set_route(:P5_PREFIX,:P5_TARGET,:P5_OLD); end;
            ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Route saved.
        }
        serverSideCondition {
            whenButtonPressed: @guardar
        }
    )

    region destino (
        name: Register a target
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/standard
        }
    )

    pageItem P5_DEST_KEY (
        type: textField
        label {
            label: Target key
        }
        layout {
            sequence: 10
            region: @destino
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )

    pageItem P5_DEST_TITLE (
        type: textField
        label {
            label: Target name
        }
        layout {
            sequence: 20
            region: @destino
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )

    button registrar (
        buttonName: REGISTRAR
        label: Register target
        layout {
            sequence: 50
            region: @destino
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
    )

    process registrar (
        name: Register target
        type: executeCode
        source {
            plsqlCode:
            ```plsql
            begin inv_data.inv_ui.register_target(:P5_DEST_KEY,:P5_DEST_TITLE); end;
            ```
        }
        execution {
            sequence: 50
        }
        successMessage {
            successMessage: Target registered.
        }
        serverSideCondition {
            whenButtonPressed: @registrar
        }
    )
)
