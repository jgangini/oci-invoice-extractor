page 3 (
    name: Field review
    alias: REVISION
    title: Field review
    appearance {
        pageTemplate: @/standard
    }
    security {
        authorizationScheme: @review
        pageAccessProtection: argumentsMustHaveChecksum
    }
    region detalle (
        name: Document evidence
        type: classicReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
            ```sql
            select member_name,label,original_text,normalized_text,approved_value,page_no,method,evidence from inv_data.inv_v_results where result_id=:P3_RESULT
            ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
        }
        reportLayout {
            numberOfRows: 20
        }
        componentAppearance {
            template: @/standard
        }
        pagination {
            type: nextAndPreviousLinks
        }
        messages {
            whenNoDataFound: No records to display.
        }
        column MEMBER_NAME (
            reportColumnQueryId: 1
            derivedColumn: N

            heading {
                heading: PDF
            }
            layout {
                sequence: 10
            }

        )
        column LABEL (
            reportColumnQueryId: 2
            derivedColumn: N

            heading {
                heading: Field
            }
            layout {
                sequence: 20
            }

        )
        column ORIGINAL_TEXT (
            reportColumnQueryId: 3
            derivedColumn: N

            heading {
                heading: Original
            }
            layout {
                sequence: 30
            }

        )
        column NORMALIZED_TEXT (
            reportColumnQueryId: 4
            derivedColumn: N

            heading {
                heading: Normalized value
            }
            layout {
                sequence: 40
            }

        )
        column APPROVED_VALUE (
            reportColumnQueryId: 5
            derivedColumn: N

            heading {
                heading: Approved value
            }
            layout {
                sequence: 50
            }

        )
        column PAGE_NO (
            reportColumnQueryId: 6
            derivedColumn: N

            heading {
                heading: Page
            }
            layout {
                sequence: 60
            }

        )
        column METHOD (
            reportColumnQueryId: 7
            derivedColumn: N

            heading {
                heading: Method
            }
            layout {
                sequence: 70
            }

        )
        column EVIDENCE (
            reportColumnQueryId: 8
            derivedColumn: N

            heading {
                heading: Evidence
            }
            layout {
                sequence: 80
            }

        )
    )
    region correccion (
        name: Correction
        type: staticContent
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
        }
    )
    pageItem P3_RESULT (
        type: displayOnly
        label {
            label: Result
        }
        layout {
            sequence: 1
            region: @correccion
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )
    pageItem P3_REV (
        type: displayOnly
        label {
            label: Review revision
        }
        layout {
            sequence: 2
            region: @correccion
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )
    pageItem P3_VALUE (
        type: textField
        label {
            label: Approved value
        }
        layout {
            sequence: 10
            region: @correccion
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )
    pageItem P3_REASON (
        type: textField
        label {
            label: Reason
        }
        layout {
            sequence: 20
            region: @correccion
            slot: regionBody
        }
        appearance {
            template: @/optional-floating
        }

    )
    button aprobar (
        buttonName: APROBAR
        label: Save correction
        layout {
            sequence: 30
            region: @correccion
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
        }
    )
    process aprobar (
        name: Save correction
        type: executeCode
        source {
            plsqlCode:
            ```plsql
            begin inv_data.inv_ui.approve(:P3_RESULT,:P3_REV,:P3_VALUE,:P3_REASON); select review_id into :P3_REV from inv_data.inv_v_results where result_id=:P3_RESULT; end;
            ```
        }
        execution {
            sequence: 30
        }
        successMessage {
            successMessage: Correction saved.
        }
        serverSideCondition {
            whenButtonPressed: @aprobar
        }
    )
)
