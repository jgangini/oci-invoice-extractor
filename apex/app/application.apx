app INVOICE-EXTRACTOR (
    name: Invoice Extractor
    logo {
        type: text
        text: Invoice Extractor
    }
    navigation {
        homeUrl: {
            page: 1
        }
        loginUrl: {
            page: LOGIN
        }
    }
    navigationMenu {
        listTemplate: @/side-navigation-menu
        templateOptions: [
            #DEFAULT#
            t-TreeNav--styleA
            js-navCollapsed--hidden
        ]
        list: @navigation-menu
    }
    navigationBar {
        list: @navigation-bar
        listTemplate: @/navigation-bar
        templateOptions: #DEFAULT#
    }
    css {
        fileUrls: #APP_FILES#invoice.css
    }
    userInterface {
        currentTheme: @universal-theme
        globalPage: 0
        addBuiltWithApexToFooter: false
    }
    appFormatMasks {
        date: DD Mon YYYY
        timestamp: DD Mon YYYY HH24:MI
        timestampTimeZone: DD Mon YYYY HH24:MI TZH:TZM
    }
    globalization {
        primaryLanguage: en
        languageDerivedFrom: appPrimaryLanguage
    }
    authentication {
        scheme: @oracle-apex-accounts
    }
    sessionStateProtection {
    }
    runtime {
        allowFeedback: false
    }

    substitution APP_NAME (
        value {
            staticValue: Invoice Extractor
        }
    )

)
